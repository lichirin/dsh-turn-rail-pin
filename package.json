{
  "name": "dsh-turn-rail-pin",
  "version": "0.1.7-local.1",
  "description": "Pin the Chat turn-rail (turnOutline side rail) so it stays visible in narrow windows / high browser zoom. 让会话侧边目录条常显的开关插件。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.1-rc.1 <4",
    "@deepseek-ai/dsh-settings": ">=0.1.7-rc.1 <0.1.8"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "turn-rail",
    "turnOutline",
    "sidebar",
    "zoom"
  ],
  "license": "MIT"
}
